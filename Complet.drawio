        <mxCell id="MYfRrGjGEL26GZ4W9U8C-25" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;Paris 1900&lt;/b&gt;&lt;br&gt;2 à 3 homicides pour 100 000 habitants&lt;br&gt;avec quasi aucune immigration africaine" vertex="1">
          <mxGeometry height="60" width="350" x="-438.98716720610287" y="1226.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-26" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;Paris 2000&lt;/b&gt;&lt;br&gt;1 à 2 homicides pour 100 000 habitants&lt;br&gt;(moins de violence et plus d&#39;immigration)" vertex="1">
          <mxGeometry height="60" width="350" x="-438.98716720610287" y="1326.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-27" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#b85450;" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Ce n&#39;est pas l&#39;immigration&lt;br&gt;qui cause l&#39;insécurité,&lt;br&gt;ce sont les inégalités.&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="350" x="-438.98716720610287" y="1446.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-28" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;ul style=&quot;font-size: 15px;&quot;&gt;&lt;li&gt;L&#39;immigration clandestine = 0,14% de la pop.&lt;/li&gt;&lt;br&gt;&lt;li&gt;1 immigré sur 2 vient d&#39;Europe ou d&#39;Asie&lt;/li&gt;&lt;br&gt;&lt;li&gt;2 sur 3 sont diplômés et travaillent&lt;/li&gt;&lt;br&gt;&lt;li&gt;Le voile intégral concerne 1 personne sur 33 000&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="200" width="350" x="-20.15716720610287" y="1331.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-29" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;i style=&quot;font-size: 11px;&quot;&gt;Sources: IFOP, INED, INSEE, Ministère de l&#39;intérieur.&lt;/i&gt;" vertex="1">
          <mxGeometry height="30" width="350" x="-18.987167206102868" y="1546.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-30" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;ul style=&quot;font-size: 14px;&quot;&gt;&lt;li&gt;Le RN a détourné 4,3 millions au Parlement Européen, payé avec nos impôts.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Marine Lepen a vécu presque toute sa vie dans un château à 10 millions.&lt;/li&gt;&lt;br&gt;&lt;li&gt;La princesse Maria Carolina de Bourbon des Deux-Siciles, avec qui est sorti Jordan Bardella, détient une fortune de 70 millions.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Les milliardaires Pierre-Édouard Stérin et Vincent Bolloré, ont dépensé des millions pour faire basculer les votes en faveur du RN.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="320" width="350" x="-46.647167206102864" y="201.37" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-31" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;spacing=10;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Soumission du RN à Trump&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;font-size: 13px;&quot;&gt;&lt;li&gt;Plusieurs cadres du RN présents à son investiture.&lt;/li&gt;&lt;li&gt;Alignée à Trump sur l&#39;écologie et les droits humains.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="200" width="161.34" x="-413.48716720610287" y="2966.12" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-32" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;font-size: 15px; text-align: center;&quot;&gt;Dans le passé,&lt;br&gt;&lt;b&gt;l&#39;extrême droite a été au pouvoir en France.&lt;/b&gt;&lt;br&gt;C&#39;était le régime de Vichy, qui a collaboré avec les Nazis.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="350" x="397.18283279389715" y="197.12" as="geometry" />
        </mxCell>
        <mxCell id="MYfRrGjGEL26GZ4W9U8C-33" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;font-size: 14px; text-align: center;&quot;&gt;Plus récemment : aux USA, en Inde, en Pologne...&lt;br&gt;L&#39;extrême droite au pouvoir donne les mêmes résultats :&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="350" x="397.18283279389715" y="317.12" as="geometry" />
