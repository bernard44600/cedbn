        <mxCell id="e1CfnNvPl6L4PbfOsQKc-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#FFF2CC;gradientColor=none;gradientDirection=north;roundedPerimeter=1;shadow=1;glass=0;multiple=0;fontFamily=Helvetica;labelBackgroundColor=none;arcSize=27;fontStyle=1" value="&lt;font style=&quot;&quot;&gt;RESEAUX SOCIAUX&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;les réseaux sociaux jouent contre nous&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="390" x="9" y="590" as="geometry" />
        </mxCell>
        <mxCell id="e1CfnNvPl6L4PbfOsQKc-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;align=center;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;spacingLeft=2;fontStyle=3" value="&lt;div&gt;Il faut absolument arrêter de rebondir systématiquement sur les bêtises et les outrances que vous voyez passer.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;C’est un exercice difficile mais indispensable.&lt;/div&gt;" vertex="1">
